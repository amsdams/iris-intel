{
  "name": "iris-monorepo",
  "private": true,
  "version": "0.1.2",
  "workspaces": [
    "packages/iitc-core",
    "apps/iitc-iris"
  ],
  "scripts": {
    "dev": "npm run dev:iitc-iris",
    "dev:iitc-iris": "npm run dev -w apps/iitc-iris",
    "build": "npm run build:all",
    "build:iitc-core": "npm run build -w packages/iitc-core",
    "build:iitc-iris": "npm run build -w apps/iitc-iris",
    "build:all": "npm run build --workspaces --if-present",
    "clean": "npm run clean:all",
    "clean:iitc-core": "npm run clean -w packages/iitc-core",
    "clean:iitc-iris": "npm run clean -w apps/iitc-iris",
    "clean:all": "npm run clean --workspaces --if-present",
    "check": "npm run check:all",
    "check:iitc-core": "npm run check -w packages/iitc-core",
    "check:iitc-iris": "npm run check -w apps/iitc-iris",
    "check:all": "npm run check --workspaces --if-present",
    "test": "npm run test:all",
    "test:iitc-core": "npm run test -w packages/iitc-core",
    "test:iitc-iris": "npm run test -w apps/iitc-iris",
    "test:all": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck:all",
    "typecheck:iitc-core": "npm run typecheck -w packages/iitc-core",
    "typecheck:iitc-iris": "npm run typecheck -w apps/iitc-iris",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint:all && npm run lint:css",
    "lint:iitc-core": "npm run lint -w packages/iitc-core",
    "lint:iitc-iris": "npm run lint -w apps/iitc-iris",
    "lint:all": "npm run lint --workspaces --if-present",
    "version:bump": "bash ./scripts/release-version.sh",
    "package:iitc-iris": "npm run package -w apps/iitc-iris",
    "package:all": "npm run package:iitc-iris",
    "release:iitc-iris": "npm run package -w apps/iitc-iris",
    "release:all": "npm run release:iitc-iris",
    "lint:fix": "npm run lint:fix:all && npm run lint:css:fix",
    "lint:fix:iitc-core": "npm run lint:fix -w packages/iitc-core",
    "lint:fix:iitc-iris": "npm run lint:fix -w apps/iitc-iris",
    "lint:fix:all": "npm run lint:fix --workspaces --if-present",
    "lint:css": "stylelint 'apps/iitc-iris/**/*.css'",
    "lint:css:fix": "stylelint 'apps/iitc-iris/**/*.css' --fix",
    "dev:wb": "npm run dev:wb -w apps/iitc-iris",
    "package": "npm run package:iitc-iris",
    "release": "npm run release:iitc-iris"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
