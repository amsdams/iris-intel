{
  "name": "iris-monorepo",
  "private": true,
  "version": "0.1.2",
  "workspaces": [
    "packages/iitc-core",
    "apps/iitc-iris"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/iitc-iris",
    "dev:wb": "npm run dev:wb -w apps/iitc-iris",
    "build": "npm run build --workspaces --if-present",
    "build:wb": "npm run build:wb -w apps/iitc-iris",
    "clean": "npm run clean --workspaces --if-present",
    "check": "npm run check --workspaces --if-present && npm run lint:css && npm run build:wb",
    "lint": "npm run lint --workspaces --if-present && npm run lint:css",
    "lint:fix": "npm run lint:fix --workspaces --if-present && npm run lint:css:fix",
    "lint:css": "stylelint 'apps/iitc-iris/**/*.css'",
    "lint:css:fix": "stylelint 'apps/iitc-iris/**/*.css' --fix",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "package": "npm run package -w apps/iitc-iris",
    "package:iitc-iris": "npm run package",
    "release": "npm run package",
    "serve": "node scripts/serve-artifacts.mjs",
    "version:bump": "bash ./scripts/release-version.sh",
    "android:build": "node scripts/android.mjs :app:assembleDebug",
    "android:check": "node --test apps/android-intel-spike/tests/*.test.mjs && node scripts/android.mjs :app:testDebugUnitTest :app:lintDebug :app:assembleDebug",
    "android:serve": "npm run serve"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  }
}
