{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@iris/iitc-core": [
        "./packages/iitc-core/src"
      ],
      "@iris/iitc-core/*": [
        "./packages/iitc-core/src/*"
      ]
    }
  },
  "include": [
    "packages/iitc-core/src/**/*.ts",
    "apps/iitc-iris/src/**/*.ts",
    "apps/iitc-iris/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
